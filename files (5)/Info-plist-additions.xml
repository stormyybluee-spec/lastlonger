<!--
    LAST LONGER — Info.plist additions
    Merge these keys into the app target's Info.plist.
-->

<!-- ══ BACKGROUND EXECUTION ══════════════════════════════════════════════
     Audio only. This is what keeps AVSpeechSynthesizer and the binaural
     generator alive once the app minimises behind external media.
     Without it the audio session is torn down on resign-active and the
     coach goes silent the moment the user leaves the app.

     Do NOT add other modes. App Review scrutinises background audio: the
     app must produce continuous audible output during a session, which it
     does. Adding "processing" or "fetch" here invites rejection and buys
     nothing this app needs.
-->
<key>UIBackgroundModes</key>
<array>
    <string>audio</string>
</array>


<!-- ══ APPEARANCE ════════════════════════════════════════════════════════
     Dark only, at the OS level. Prevents any system-drawn surface
     (share sheet, alerts, StoreKit sheet) from flashing white at night.
-->
<key>UIUserInterfaceStyle</key>
<string>Dark</string>


<!-- ══ PURPOSE STRINGS ═══════════════════════════════════════════════════
     Every string here is user-facing and must survive being read aloud in
     a screenshot. Clinical, specific, no euphemism, no marketing.
-->

<!-- INFocusStatusCenter. Reading Focus state only; iOS provides no API to
     set a Focus. See FocusModeController.swift. -->
<key>NSFocusStatusUsageDescription</key>
<string>Lets the app respond when your Training Focus is on. Focus state is read on device and never leaves it.</string>

<!-- HealthKit heart rate, Phase 2. Include only when the HealthKit
     capability is enabled, or App Review flags an unused purpose string. -->
<key>NSHealthShareUsageDescription</key>
<string>Reads heart rate during a session so the coach can pace you. Heart rate stays on this device and is never uploaded.</string>
<key>NSHealthUpdateUsageDescription</key>
<string>Records session duration to Health so it appears alongside your other activity. Optional and off by default.</string>

<!-- CoreMotion. WATCH TARGET ONLY. Do not add to the iPhone target —
     the iPhone explicitly does not read motion, and shipping this string
     on the phone contradicts the privacy claim on the paywall. -->
<key>NSMotionUsageDescription</key>
<string>Uses Apple Watch wrist motion to detect excessive grip tension. Motion data stays on your Watch and iPhone.</string>


<!-- ══ FONTS ═════════════════════════════════════════════════════════════
     Bitmap display face. Add the .ttf to the target's Copy Bundle Resources
     and confirm the PostScript name matches PixelFont.postScriptName in
     Theme.swift — the filename and the PostScript name are frequently
     different, and a mismatch fails silently to the system fallback.

     Use an SIL Open Font License face (Silkscreen, Departure Mono,
     Press Start 2P). Bundling a commercially licensed font without a
     desktop-plus-app licence is a real legal exposure on a paid app.
-->
<key>UIAppFonts</key>
<array>
    <string>Silkscreen-Bold.ttf</string>
</array>


<!-- ══ EXPORT COMPLIANCE ═════════════════════════════════════════════════
     No custom cryptography; only the OS-provided HTTPS used by StoreKit.
     Setting this skips the export-compliance questionnaire on every upload.
-->
<key>ITSAppUsesNonExemptEncryption</key>
<false/>


<!-- ══ ORIENTATION ═══════════════════════════════════════════════════════
     Portrait only. The overlay widget, the countdown, and every panel are
     laid out for one-handed portrait use.
-->
<key>UISupportedInterfaceOrientations</key>
<array>
    <string>UIInterfaceOrientationPortrait</string>
</array>


<!-- ══ LAUNCH SCREEN ═════════════════════════════════════════════════════
     Pure black, no content. SplashView.swift draws the real splash; the
     launch screen exists only so there is no white flash before it.
-->
<key>UILaunchScreen</key>
<dict>
    <key>UIColorName</key>
    <string>LaunchBackground</string>
</dict>
<!-- Add a colour set named "LaunchBackground" in Assets.xcassets, set to
     #000000 for both Any and Dark appearances. -->
